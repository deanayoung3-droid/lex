# Lex settings. `npm run setup` writes these for you; to do it by hand, copy this file:
#   to .env.local for local development (npm run dev), or
#   to .env for Docker (docker compose up).
# Restart the server after changing anything here. Everything else is set in the admin.

# ─── Required ────────────────────────────────────────────────────────────────────────────────

# The admin password. Use a long random value.
ADMIN_PASSWORD=

# Signs admin sessions and the anonymous visitor ids. Generate it once: openssl rand -hex 32
SESSION_SECRET=

# The address of this server, with no trailing slash. The install snippet and the links in lead
# notifications use it. http://localhost:3000 for local development.
PUBLIC_URL=http://localhost:3000

# Lex answers with the OpenAI API: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─── Optional ────────────────────────────────────────────────────────────────────────────────

# Models. Answers use a fast model; suggested questions and topic grouping a light one.
# OPENAI_ANSWER_MODEL=gpt-6.1-terra
# OPENAI_LIGHT_MODEL=gpt-6-luna
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# The most questions a day across all visitors, so a busy or abused site can't run up a bill.
# DAILY_QUESTION_LIMIT=500

# PostgreSQL with the pgvector extension. When unset, a built-in Postgres (PGlite) runs inside the
# app and keeps its data in ./data (or DATA_DIR). docker-compose.yml sets this to its own Postgres.
# DATABASE_URL=postgresql://user:password@host:5432/lex
# DATA_DIR=./data

# New leads post to this Slack incoming webhook when none is set in the admin.
# SLACK_WEBHOOK_URL=

# Set to 1 to stop this server reading the website and grouping questions in the background
# (when another server does it).
# SCHEDULER_DISABLED=1
